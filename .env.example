# --- PayPal sandbox (US Business sandbox account REST app; India-based accounts cannot send Payouts) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Sandbox PERSONAL account email that receives the squad Payout ---
PAYOUT_RECIPIENT_EMAIL=
MAX_ORDER_USD=50

# --- AI Engines ---
# Google Gemini (Free tier recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (Optional alternative)
ANTHROPIC_API_KEY=
ORYN_MODEL=claude-3-5-sonnet-latest

# --- App ---
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me

# Limits
DAILY_AI_CALLS_CAP=300
DAILY_PAYOUT_CAP_USD=25
PER_IP_CHAT_PER_MIN=10
