# --- PayPal sandbox (US Business sandbox account REST app; India-based accounts cannot send Payouts) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# --- Anthropic (set a spend limit in the console) ---
ANTHROPIC_API_KEY=
ORYN_MODEL=claude-sonnet-5-5
# --- App ---
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me
# Limits
DAILY_AI_CALLS_CAP=300
DAILY_PAYOUT_CAP_USD=25
PER_IP_CHAT_PER_MIN=10
# Optional: real sandbox subscription IDs seeded for the demo, JSON array
# SEED_SUBSCRIPTIONS=[{"id":"I-XXXXXXXX","name":"StreamBox","amountUsd":15.99},{"id":"I-YYYYYYYY","name":"FitPass","amountUsd":29}]
